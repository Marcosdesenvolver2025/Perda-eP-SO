# dependências
node_modules/

# variáveis de ambiente — nunca comite chave secreta
.env
.env.local
.env.*.local
!.env.exemplo

# build
dist/
build/
*.tsbuildinfo

# expo
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Só as pastas que o `expo prebuild` gera dentro do app. Antes eram `android/`
# e `ios/` soltos, o que engolia QUALQUER pasta com esse nome no projeto —
# inclusive jogo/android/, que é código escrito à mão e precisa ser versionado.
app/android/
app/ios/

# credenciais de publicação
app/credenciais/
*-service-account.json

# prisma
servidor/prisma/*.db
servidor/prisma/migrations/dev.db*

# logs
*.log
npm-debug.log*
yarn-error.log*

# sistema
.DS_Store
Thumbs.db

# editores
.vscode/
.idea/

# python
__pycache__/
*.pyc
