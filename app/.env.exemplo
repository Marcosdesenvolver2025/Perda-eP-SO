# Copie para .env e preencha. Tudo que começa com EXPO_PUBLIC_ vai embutido no
# app — nunca coloque chave secreta aqui, só as públicas.

# Endereço da sua API. Deixe VAZIO para rodar o app em modo demonstração.
#   emulador Android apontando pro seu PC: http://10.0.2.2:3333
EXPO_PUBLIC_API_URL=

# Client ID do tipo "Web" do Google Cloud (o mesmo do servidor).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Chave PÚBLICA da pagar.me (pk_test_... em homologação).
# É com ela que o cartão vira token no próprio celular.
EXPO_PUBLIC_PAGARME_CHAVE_PUBLICA=
