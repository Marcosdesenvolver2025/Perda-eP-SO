# Copie para .env e preencha. NUNCA comite o .env — ele tem as chaves secretas.

NODE_ENV=development
PORTA=3333

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@localhost:5432/vendasitinga?schema=public"

# ---------------------------------------------------------------------------
# Sessão do app
# Gere com:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SEGREDO=
JWT_EXPIRACAO=30d

# ---------------------------------------------------------------------------
# Login com Google
# Os dois IDs saem do mesmo projeto no Google Cloud.
# O WEB é obrigatório: é ele que valida o id_token que o app manda.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=

# ---------------------------------------------------------------------------
# pagar.me
#
# A chave SECRETA fica só aqui. Nunca no app, nunca no repositório.
# Escopo necessário na pagar.me: leitura e escrita em Transacional,
# Financeiro e Recebedores.
#
# Se esta chave vazar (print, chat, log, commit), revogue no painel e gere
# outra — trocar o valor aqui é suficiente, não precisa mexer no código.
# ---------------------------------------------------------------------------
PAGARME_SECRET_KEY=
PAGARME_URL_BASE=https://api.pagar.me/core/v5

# recipient_id da SUA conta: é para onde vai a comissão
PAGARME_RECEBEDOR_PLATAFORMA=

# Autenticação básica do webhook, configurada no painel da pagar.me
PAGARME_WEBHOOK_USUARIO=
PAGARME_WEBHOOK_SENHA=

# ---------------------------------------------------------------------------
# Regras de negócio
# Mudar aqui vale na hora, sem precisar de nova versão do app na Play Store.
# ---------------------------------------------------------------------------
# Comissão sobre o produto. Vale nas duas modalidades de entrega.
COMISSAO=0.12

# Valor mínimo de venda, em centavos (1000 = R$ 10,00).
VALOR_MINIMO_VENDA=1000

# Quanto o entregador recebe por corrida concluída, em centavos.
# Sai da tarifa fixa; não é cobrado do comprador.
PAGAMENTO_POR_ENTREGA=500

# Prazo do comprador para testar e pedir devolução (CDC art. 49).
DIAS_PARA_TESTAR=7

# Modalidade VENDEDOR: prazo para o comprador confirmar depois que o vendedor
# declara a entrega sem o código. Vencido o prazo, o sistema confirma sozinho.
DIAS_PARA_CONFIRMACAO_AUTOMATICA=3

# A tabela de tarifas por faixa fica em servidor/src/dominio/regras.ts —
# mudá-la exige deploy, porque o app também precisa conhecer as faixas.

CIDADE=Itinga
UF=MG

# ---------------------------------------------------------------------------
# CORS — use * só em desenvolvimento
# ---------------------------------------------------------------------------
ORIGENS_PERMITIDAS=*
