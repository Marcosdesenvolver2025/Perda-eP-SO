# Copie para .env e preencha. NUNCA comite o .env — ele tem as chaves secretas.

NODE_ENV=development
PORTA=3333

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@localhost:5432/vendasitinga?schema=public"

# ---------------------------------------------------------------------------
# Sessão do app
# Gere com:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SEGREDO=
JWT_EXPIRACAO=30d

# ---------------------------------------------------------------------------
# Login com Google
# Os dois IDs saem do mesmo projeto no Google Cloud.
# O WEB é obrigatório: é ele que valida o id_token que o app manda.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=

# ---------------------------------------------------------------------------
# pagar.me
# Comece com as chaves de teste (sk_test_). Só troque para produção depois de
# rodar o checklist de documentos/split-pagarme.md inteiro.
# ---------------------------------------------------------------------------
PAGARME_CHAVE_SECRETA=sk_test_
PAGARME_URL_BASE=https://api.pagar.me/core/v5

# recipient_id da SUA conta: é para onde vai a comissão
PAGARME_RECEBEDOR_PLATAFORMA=

# Autenticação básica do webhook, configurada no painel da pagar.me
PAGARME_WEBHOOK_USUARIO=
PAGARME_WEBHOOK_SENHA=

# ---------------------------------------------------------------------------
# Regras de negócio
# Mudar aqui vale na hora, sem precisar de nova versão do app na Play Store.
# ---------------------------------------------------------------------------
COMISSAO_SEM_ENTREGADOR=0.16
COMISSAO_COM_ENTREGADOR=0.18
REPASSE_ENTREGADOR=0.8
DIAS_PARA_TESTAR=4

CIDADE=Itinga
UF=MA

# ---------------------------------------------------------------------------
# CORS — use * só em desenvolvimento
# ---------------------------------------------------------------------------
ORIGENS_PERMITIDAS=*
