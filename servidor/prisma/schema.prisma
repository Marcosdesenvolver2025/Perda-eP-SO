// Banco do Vendas Itinga.
// Dinheiro é sempre Int em CENTAVOS. Peso em GRAMAS. Medidas em CENTÍMETROS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  CLIENTE // compra e vende
  ENTREGADOR // faz as coletas e entregas
  ADMIN // equipe do Vendas Itinga
}

enum EstadoAnuncio {
  RASCUNHO
  ATIVO
  PAUSADO
  VENDIDO
  REMOVIDO
}

enum CondicaoProduto {
  NOVO
  SEMINOVO
  USADO
}

/// Quem faz a entrega. Escolhido pelo vendedor no anúncio e CONGELADO no
/// pedido: se a política mudar, o pedido antigo mantém a regra da venda.
enum ModalidadeEntrega {
  PLATAFORMA // entregador da plataforma: cobra 12% + tarifa da faixa
  VENDEDOR // o próprio vendedor entrega: cobra só os 12%
}

/// Estados do pedido. Os financeiros (AGUARDANDO_PAGAMENTO, PAGO, REEMBOLSADO,
/// CANCELADO) pertencem ao fluxo da pagar.me e não são tocados pela logística.
enum EstadoPedido {
  AGUARDANDO_PAGAMENTO
  PAGO // dinheiro retido; ponte entre o financeiro e a logística
  // --- modalidade PLATAFORMA ---
  AGUARDANDO_AGENDAMENTO_DE_COLETA // entrega criada, esperando o admin atribuir
  A_CAMINHO_DA_COLETA
  PRODUTO_COLETADO
  EM_ROTA_PARA_ENTREGA
  // --- modalidade VENDEDOR ---
  AGUARDANDO_ENTREGA_DO_VENDEDOR // pago; o vendedor combina e entrega
  ENTREGA_DECLARADA // vendedor declarou entrega sem código; conta o prazo de confirmação
  // --- comum às duas ---
  ENTREGUE // começa a contar a janela de 7 dias
  CONCLUIDO // janela venceu e o repasse foi liberado
  DEVOLUCAO_SOLICITADA
  DEVOLUCAO_APROVADA
  DEVOLUCAO_EM_TRANSITO // entregador levando o produto de volta ao vendedor
  DEVOLUCAO_COMBINADA // modalidade VENDEDOR: partes combinam; admin confirma o retorno
  DEVOLVIDO_AO_VENDEDOR // gatilho do estorno
  REEMBOLSADO
  CANCELADO
}

/// A mesma entrega serve para levar ao comprador e para trazer de volta.
enum TipoEntrega {
  ENTREGA // vendedor -> comprador
  DEVOLUCAO // comprador -> vendedor
}

enum EstadoEntrega {
  AGUARDANDO_ATRIBUICAO // na fila do administrador
  ATRIBUIDA // admin escolheu um entregador, aguardando aceite
  RECUSADA // entregador recusou; volta para a fila
  ACEITA
  A_CAMINHO_DA_COLETA
  CHEGOU_NA_COLETA
  PRODUTO_COLETADO
  EM_ROTA_PARA_ENTREGA
  CHEGOU_NA_ENTREGA
  ENTREGUE
  CANCELADA
}

enum EstadoReembolso {
  SOLICITADO
  EM_ANALISE
  APROVADO // aprovado; aguardando a coleta reversa
  RECUSADO
  CONCLUIDO // produto devolvido e estorno feito
}

enum EstadoOferta {
  ABERTA
  CONTRAPROPOSTA
  ACEITA
  RECUSADA
  EXPIRADA
  CANCELADA
}

enum AtorDaOferta {
  COMPRADOR
  VENDEDOR
}

enum EstadoRecebedor {
  PENDENTE // cadastrado na pagar.me, aguardando aprovação
  ATIVO
  RECUSADO
  BLOQUEADO
}

model Usuario {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  nome      String
  fotoUrl   String?
  telefone  String?
  cpf       String?  @unique
  papel     Papel    @default(CLIENTE)
  bairro    String?
  cidade    String   @default("Itinga")
  uf        String   @default("MG")
  apelidoLoja String? @unique
  bioLoja   String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  // exclusão de conta exigida pela Google Play: marcamos e anonimizamos
  excluidoEm DateTime?

  // --- campos usados só quando papel = ENTREGADOR -------------------------
  /// Entregador marca que está aceitando corridas.
  entregadorDisponivel Boolean @default(false)
  /// Última posição informada. Serve para a futura atribuição automática.
  entregadorLat        Float?
  entregadorLng        Float?
  entregadorPosicaoEm  DateTime?
  /// Quantas corridas ele consegue tocar ao mesmo tempo.
  entregadorCapacidade Int     @default(1)

  anuncios      Anuncio[]
  compras       Pedido[]        @relation("Comprador")
  vendas        Pedido[]        @relation("Vendedor")
  entregas      Entrega[]       @relation("Entregador")
  recusas       RecusaEntrega[]
  recebedor     Recebedor?
  enderecos     Endereco[]
  mensagens     Mensagem[]
  avaliacoesFeitas Avaliacao[]  @relation("Autor")
  avaliacoesRecebidas Avaliacao[] @relation("Avaliado")
  dispositivos  Dispositivo[]
  favoritos     Favorito[]
  seguindo      Seguidor[]      @relation("Seguindo")
  seguidores    Seguidor[]      @relation("Seguidores")
  ofertasFeitas    Oferta[]     @relation("OfertasFeitas")
  ofertasRecebidas Oferta[]     @relation("OfertasRecebidas")

  @@index([cidade, papel])
  @@index([papel, entregadorDisponivel])
}

/// Recebedor na pagar.me. Sem isso o usuário não recebe o split.
model Recebedor {
  id             String          @id @default(cuid())
  usuarioId      String          @unique
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// recipient_id devolvido pela pagar.me (rp_...)
  recipientId    String          @unique
  estado         EstadoRecebedor @default(PENDENTE)
  /// documento usado no cadastro (CPF ou CNPJ), guardado só com os dígitos
  documento      String
  tipo           String // "individual" ou "company"
  bancoCodigo    String?
  agencia        String?
  conta          String?
  chavePix       String?
  /// Transferência automática fica DESLIGADA: o repasse só sai quando a
  /// janela de 7 dias vence (ver servicos/repasse.ts).
  transferenciaAutomatica Boolean @default(false)
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
}

model Endereco {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  apelido    String? // "casa", "trabalho"
  cep        String
  logradouro String
  numero     String
  complemento String?
  bairro     String
  cidade     String   @default("Itinga")
  uf         String   @default("MG")
  referencia String?
  /// Coordenadas opcionais, para a futura atribuição automática por distância.
  latitude   Float?
  longitude  Float?
  principal  Boolean  @default(false)
  criadoEm   DateTime @default(now())

  pedidos          Pedido[]
  anunciosColeta   Anuncio[] @relation("EnderecoDeColeta")
}

model Categoria {
  id       String     @id @default(cuid())
  slug     String     @unique
  nome     String
  emoji    String?
  ordem    Int        @default(0)
  paiId    String?
  pai      Categoria? @relation("Subcategorias", fields: [paiId], references: [id])
  filhos   Categoria[] @relation("Subcategorias")
  anuncios Anuncio[]
}

model Anuncio {
  id          String          @id @default(cuid())
  vendedorId  String
  vendedor    Usuario         @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  categoriaId String?
  categoria   Categoria?      @relation(fields: [categoriaId], references: [id])

  titulo      String
  descricao   String
  /// preço em centavos; é o total que o comprador paga
  preco       Int
  precoOriginal Int?
  condicao    CondicaoProduto @default(USADO)
  marca       String?
  tamanho     String?
  cor         String?
  estado      EstadoAnuncio   @default(ATIVO)

  /// medidas aproximadas da embalagem: limite de 20 kg e 60 cm por lado
  pesoG        Int
  comprimentoCm Int
  larguraCm    Int
  alturaCm     Int

  /// Onde o entregador busca o produto. Obrigatório para aceitar entregador
  /// próprio; o vendedor escolhe um dos endereços cadastrados dele.
  enderecoColetaId String?
  enderecoColeta   Endereco? @relation("EnderecoDeColeta", fields: [enderecoColetaId], references: [id])

  /// Quem entrega este produto. Define a taxa e se há limite de peso/tamanho.
  modalidadeEntrega ModalidadeEntrega @default(PLATAFORMA)

  visualizacoes Int      @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  fotos     FotoAnuncio[]
  pedidos   Pedido[]
  favoritos Favorito[]
  ofertas   Oferta[]

  @@index([estado, criadoEm])
  @@index([vendedorId, estado])
  @@index([categoriaId, estado])
}

model FotoAnuncio {
  id        String  @id @default(cuid())
  anuncioId String
  anuncio   Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  url       String
  ordem     Int     @default(0)

  @@index([anuncioId, ordem])
}

/// Curtida. É a lista de desejos do comprador e o termômetro do vendedor:
/// anúncio muito curtido e pouco vendido costuma ser preço fora do lugar.
model Favorito {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anuncioId String
  anuncio   Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, anuncioId])
  @@index([usuarioId, criadoEm])
}

/// Quem segue a lojinha de quem. Serve para avisar de anúncio novo.
model Seguidor {
  id         String   @id @default(cuid())
  seguidorId String
  seguidor   Usuario  @relation("Seguindo", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguidoId  String
  seguido    Usuario  @relation("Seguidores", fields: [seguidoId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())

  @@unique([seguidorId, seguidoId])
  @@index([seguidoId])
}

/// Negociação de preço. Regras em `src/dominio/ofertas.ts`.
///
/// `valorAtual` é o último lance — proposta do comprador ou contraproposta do
/// vendedor. Quando o estado vira ACEITA, é esse valor que o checkout cobra,
/// entrando no split como se fosse o preço do anúncio.
model Oferta {
  id          String       @id @default(cuid())
  anuncioId   String
  anuncio     Anuncio      @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  compradorId String
  comprador   Usuario      @relation("OfertasFeitas", fields: [compradorId], references: [id], onDelete: Cascade)
  vendedorId  String
  vendedor    Usuario      @relation("OfertasRecebidas", fields: [vendedorId], references: [id], onDelete: Cascade)

  /// Preço do anúncio quando a negociação começou. Congelado: se o vendedor
  /// mudar o preço no meio da conversa, a oferta continua valendo o que valia.
  precoAnunciado Int
  /// Último lance, em centavos.
  valorAtual     Int
  estado         EstadoOferta   @default(ABERTA)
  /// Quem fez o último lance. Define de quem é a vez de responder.
  ultimoLancePor AtorDaOferta   @default(COMPRADOR)
  /// Recado curto de quem propôs.
  recado         String?

  /// Começa a contar do último lance, não da criação.
  lanceEm     DateTime  @default(now())
  respondidoEm DateTime?
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt

  lances  LanceDaOferta[]
  pedido  Pedido?

  @@index([vendedorId, estado])
  @@index([compradorId, estado])
  @@index([anuncioId, estado])
}

/// Histórico da negociação, para as duas partes verem como chegaram no valor.
model LanceDaOferta {
  id       String       @id @default(cuid())
  ofertaId String
  oferta   Oferta       @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  por      AtorDaOferta
  valor    Int
  recado   String?
  criadoEm DateTime     @default(now())

  @@index([ofertaId, criadoEm])
}

model Pedido {
  id         String            @id @default(cuid())
  /// código curto mostrado ao usuário, ex.: VI-8KQ2
  codigo     String            @unique
  anuncioId  String
  anuncio    Anuncio           @relation(fields: [anuncioId], references: [id])
  compradorId String
  comprador  Usuario           @relation("Comprador", fields: [compradorId], references: [id])
  vendedorId String
  vendedor   Usuario           @relation("Vendedor", fields: [vendedorId], references: [id])
  enderecoId String?
  endereco   Endereco?         @relation(fields: [enderecoId], references: [id])

  modalidade ModalidadeEntrega
  estado     EstadoPedido      @default(AGUARDANDO_PAGAMENTO)

  /// Preenchido quando o pedido nasceu de uma oferta aceita. Guarda por que
  /// o `valorProduto` é menor que o preço do anúncio.
  ofertaId   String?           @unique
  oferta     Oferta?           @relation(fields: [ofertaId], references: [id])

  /// valores congelados no momento da compra (centavos)
  /// O comprador paga só `valorProduto`; não há cobrança separada de frete.
  valorProduto    Int
  valorTotal      Int
  taxaComissao    Float
  valorComissao   Int
  valorTarifa     Int
  valorVendedor   Int
  valorPlataforma Int
  /// Custo da corrida pago ao entregador. Sai da plataforma, NÃO do split
  /// da cobrança — por isso é custo, não parte do rateio.
  custoEntregador Int @default(0)

  /// identificadores da pagar.me
  pagarmeOrderId  String? @unique
  pagarmeChargeId String? @unique
  metodoPagamento String? // credit_card, pix
  parcelas        Int     @default(1)

  /// Código que o comprador informa ao vendedor (modalidade VENDEDOR) ou ao
  /// entregador (modalidade PLATAFORMA, guardado na Entrega). Visível só ao
  /// comprador.
  codigoConfirmacao String?

  pagoEm      DateTime?
  /// Modalidade VENDEDOR: quando o vendedor declarou a entrega sem o código.
  entregaDeclaradaEm DateTime?
  /// Prazo da confirmação automática (entregaDeclaradaEm + 3 dias).
  prazoConfirmacaoAte DateTime?
  /// Como a entrega foi confirmada: "codigo", "comprador" ou "automatica".
  confirmadaPor String?
  entregueEm  DateTime?
  /// entregueEm + janela de teste; depois disso o repasse é liberado
  prazoTesteAte DateTime?
  repassadoEm DateTime?
  canceladoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entregas  Entrega[]
  reembolso Reembolso?
  mensagens Mensagem[]
  eventos   EventoPedido[]
  avaliacoes Avaliacao[]

  @@index([compradorId, criadoEm])
  @@index([vendedorId, criadoEm])
  @@index([estado, prazoTesteAte])
}

/// Uma corrida: ida (vendedor -> comprador) ou volta (comprador -> vendedor).
model Entrega {
  id           String        @id @default(cuid())
  pedidoId     String
  pedido       Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo         TipoEntrega   @default(ENTREGA)
  entregadorId String?
  entregador   Usuario?      @relation("Entregador", fields: [entregadorId], references: [id])
  estado       EstadoEntrega @default(AGUARDANDO_ATRIBUICAO)

  /// quanto o entregador recebe por esta corrida (centavos)
  valorEntregador Int @default(0)

  /// endereços resolvidos na criação, para o histórico não mudar se o
  /// usuário editar o cadastro depois
  coletaEndereco   String
  coletaReferencia String?
  coletaContato    String? // nome de quem entrega o produto ao entregador
  coletaTelefone   String? // guardado inteiro; a API devolve mascarado
  entregaEndereco  String
  entregaReferencia String?
  entregaContato   String?
  entregaTelefone  String?
  observacoes      String?

  /// janela combinada para a coleta
  janelaColetaInicio DateTime?
  janelaColetaFim    DateTime?

  /// comprovação da coleta
  fotoPacoteUrl String?
  volumes       Int?

  /// comprovação da entrega
  codigoConfirmacao  String?
  fotoEntregaUrl     String?

  atribuidaPorId String?
  atribuidaEm    DateTime?
  aceitaEm       DateTime?
  coletadaEm     DateTime?
  entregueEm     DateTime?
  canceladaEm    DateTime?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  recusas RecusaEntrega[]
  eventos EventoEntrega[]

  @@index([estado, criadoEm])
  @@index([entregadorId, estado])
  @@index([pedidoId, tipo])
}

/// Recusa registrada: serve de histórico e evita reoferecer ao mesmo entregador.
model RecusaEntrega {
  id           String   @id @default(cuid())
  entregaId    String
  entrega      Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  entregadorId String
  entregador   Usuario  @relation(fields: [entregadorId], references: [id], onDelete: Cascade)
  motivo       String
  criadoEm     DateTime @default(now())

  @@unique([entregaId, entregadorId])
  @@index([entregadorId, criadoEm])
}

/// Trilha de auditoria da corrida: cada transição de estado vira um evento.
model EventoEntrega {
  id        String   @id @default(cuid())
  entregaId String
  entrega   Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  de        EstadoEntrega?
  para      EstadoEntrega
  autorId   String?
  detalhe   Json?
  criadoEm  DateTime @default(now())

  @@index([entregaId, criadoEm])
}

model Reembolso {
  id        String          @id @default(cuid())
  pedidoId  String          @unique
  pedido    Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  estado    EstadoReembolso @default(SOLICITADO)
  motivo    String
  descricao String?
  fotosUrls String[]

  /// quanto volta ao comprador e quanto a plataforma retém (centavos)
  valorReembolsado Int
  valorRetido      Int
  debitoVendedor   Int
  debitoPlataforma Int

  pagarmeEstornoId String?
  analisadoPor     String?
  respostaEquipe   String?

  solicitadoEm DateTime  @default(now())
  aprovadoEm   DateTime?
  concluidoEm  DateTime?

  @@index([estado, solicitadoEm])
}

model Mensagem {
  id        String   @id @default(cuid())
  pedidoId  String?
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  anuncioId String?
  autorId   String
  autor     Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  destinatarioId String
  texto     String
  lidaEm    DateTime?
  criadoEm  DateTime @default(now())

  @@index([destinatarioId, lidaEm])
  @@index([pedidoId, criadoEm])
}

model Avaliacao {
  id        String   @id @default(cuid())
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  autorId   String
  autor     Usuario  @relation("Autor", fields: [autorId], references: [id], onDelete: Cascade)
  avaliadoId String
  avaliado  Usuario  @relation("Avaliado", fields: [avaliadoId], references: [id], onDelete: Cascade)
  nota      Int // 1 a 5
  comentario String?
  criadoEm  DateTime @default(now())

  @@unique([pedidoId, autorId])
  @@index([avaliadoId])
}

/// Trilha de auditoria do pedido: toda mudança relevante vira um evento.
model EventoPedido {
  id       String   @id @default(cuid())
  pedidoId String
  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo     String
  detalhe  Json?
  autorId  String?
  criadoEm DateTime @default(now())

  @@index([pedidoId, criadoEm])
}

/// Token de push por aparelho (avisos de venda, coleta, entrega e prazo).
model Dispositivo {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token     String   @unique
  plataforma String  @default("android")
  criadoEm  DateTime @default(now())
}

/// Webhooks da pagar.me já processados, para não processar duas vezes.
model WebhookRecebido {
  id          String   @id @default(cuid())
  eventoId    String   @unique
  tipo        String
  conteudo    Json
  processadoEm DateTime @default(now())
}
