# ==========================================================
# Vendas Itinga - Backend - Variaveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA faca commit do arquivo .env preenchido.
# ==========================================================

# --- Servidor ---
NODE_ENV=development
PORT=3333
API_PUBLIC_URL=http://localhost:3333

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vendas_itinga?schema=public"

# --- JWT (sessao do app) ---
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=30d

# --- Google Sign-In ---
# IDs de cliente OAuth criados no Google Cloud Console.
# Aceita varios separados por virgula (web, android, ios).
GOOGLE_CLIENT_IDS=000000000000-web.apps.googleusercontent.com,000000000000-android.apps.googleusercontent.com,000000000000-ios.apps.googleusercontent.com

# --- Firebase Admin (opcional: valida ID token do Firebase Auth) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A chave privada deve vir entre aspas e com \n literais
FIREBASE_PRIVATE_KEY=""

# --- Pagar.me (API v5) ---
# ATENCAO: chaves ficam SOMENTE aqui, nunca no codigo ou no app.
# Cole aqui a chave SECRETA do painel do Pagar.me (comeca com "sk_")
PAGARME_API_KEY=cole-aqui-sua-chave-secreta-do-pagarme
# Chave de criptografia do painel do Pagar.me (comeca com "ek_")
PAGARME_ENCRYPTION_KEY=cole-aqui-sua-chave-de-criptografia
PAGARME_API_URL=https://api.pagar.me/core/v5
# Recebedor (recipient) da plataforma que recebe a comissao
PAGARME_PLATFORM_RECIPIENT_ID=re_000000000000000000
# Assinatura dos webhooks (Basic Auth configurado no dashboard do Pagar.me)
PAGARME_WEBHOOK_USER=vendasitinga
PAGARME_WEBHOOK_PASSWORD=troque-esta-senha

# --- Regras de negocio ---
MIN_PRODUCT_PRICE_CENTS=1000
MAX_PRODUCT_WEIGHT_GRAMS=20000
MAX_PRODUCT_HEIGHT_CM=60
PLATFORM_FEE_BPS_FLEET=2000
PLATFORM_FEE_BPS_OWN=1500
TEST_PERIOD_DAYS=4
GATEWAY_SETTLEMENT_DAYS=2

# --- Logistica propria ---
SHIPPING_BASE_CENTS=990
SHIPPING_PER_KG_CENTS=200
SHIPPING_MAX_RADIUS_KM=30
