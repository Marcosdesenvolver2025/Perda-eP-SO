# ==========================================================
# Vendas Itinga - App (Expo) - Variaveis PUBLICAS
# Copie para ".env" (usado no `expo start`). Em builds EAS,
# defina os mesmos nomes no eas.json (env) ou como secrets.
#
# Regra: aqui SO entram valores publicos. A chave secreta do
# Pagar.me e as credenciais do banco ficam apenas no backend.
# ==========================================================

EXPO_PUBLIC_API_URL=http://localhost:3333

# Chave PUBLICA do Pagar.me, do painel (comeca com "pk_").
# Usada so para tokenizar o cartao no dispositivo - pode ir para o app.
EXPO_PUBLIC_PAGARME_PUBLIC_KEY=cole-aqui-sua-chave-publica-do-pagarme

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-android.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-ios.apps.googleusercontent.com

# Firebase (opcional)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
